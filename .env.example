# Copia este archivo como .env.local y ajusta los valores.
# NUNCA subas secretos al repositorio: el frontend no maneja secretos,
# solo la ruta base de la API y el modo de operación.

# mock = backend simulado en memoria (para demostración y pruebas)
# real = backend real en VITE_API_BASE
VITE_API_MODE=mock

# Ruta base de la API (misma origen; Nginx o el proxy de Vite la redirigen al backend)
VITE_API_BASE=/api/v1

# Minutos de inactividad antes de cerrar sesión (RS-SES-03)
VITE_IDLE_MINUTES=15

# Solo para desarrollo: a dónde reenvía el proxy de Vite las llamadas /api
VITE_PROXY_TARGET=http://localhost:3000
